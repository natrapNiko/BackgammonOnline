@{
    ViewData["Title"] = "Backgammon";
}

<div class="container mt-5">

    <div class="text-center">

        <h1 class="display-4">
            Backgammon Online
        </h1>

        <p class="lead">
            Wellcome to Backgammon Online!
        </p>

        <p>
            Play International Backgammon (Portes)
            or Bulgarian Tapa.
        </p>

        <hr />

        <h3>Game modes</h3>

        <div class="mt-4">

            <button class="btn btn-primary m-2" disabled>
                Play vs Computer
            </button>

            <button class="btn btn-success m-2" disabled>
                Play Online
            </button>

            <button class="btn btn-warning m-2" disabled>
                Create Private Game
            </button>

        </div>

        <p class="text-muted mt-4">
            Game functionality will be implemented
            in the next development stages.
        </p>

    </div>

</div>