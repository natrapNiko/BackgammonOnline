@model List<BackgammonOnline.Web.Models.Entities.GameRoom>

@{
    ViewData["Title"] = "Game Lobby";
}

<div class="container mt-4">

    <h1 class"mb-3">Game Lobby</h1>

    <p class="text-muted">
        Browse public Backgamoon rooms.
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="GameRoom" asp-action="Create" class="btn btn-success mb-4">
            Create Game Room
        </a>
    }
    else
    {
        <p>
            <a asp-area="Identity" asp-page="/Account/Login">
                Sign in
            </a>
            to create a game room.
        </p>
    }

    @if (TempData["SucessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No public game rooms are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Room Name</th>
                        <th>Variant</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>@room.Name</td>
                            <td>@room.Variant</td>
                            <td>@room.Status</td>
                            <td>@room.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                            <a asp-controller="GameRoom"
                            asp-action="Details"
                            asp-route-id="@room.Id"
                            class="btn btn-sm btn-primary">
                            Details
                            </a>
                            </td>
                        
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
