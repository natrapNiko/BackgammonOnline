@model BackgammonOnline.Web.ViewModels.CreateGameRoomViewModel

@using BackgammonOnline.Web.Models.Enums

@{
    ViewData["Title"] = "Create Game Room";
}

<div class="container mt-4">

    <h1 class="mb-3">Create Game Room</h1>

    <p class="text-muted">
        Create a public or private Backgammon room.
    </p>

    <div class="row">
        <div class="col-md-6">

            <form asp-controller="GameRoom"
                  asp-action="Create"
                  method="post">
              
               @Html.AntiForgeryToken()
               
               <div asp-validation-summary="ModelOnly"
                    class="text-danger mb-3"></div>

               <div class="mb-3">
                   <label asp-for="Name"
                          class="form-label"></label>

                   <input asp-for="Name"
                          class="form-label" />

                   <span asp-validation-for="Name"
                         class="text-danger"></span>
               </div>
              
               <div class="mb-3">
                    <label asp-for="Variant"
                           class="form-label"></label>
                           
                    <select asp-for="Variant"
                            asp-items="Html.GetEnumSelectList<GameVariant>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Variant"
                          class="form-select"></span>
               </div>

               <div class="form-check mb-3">

                   <input asp-for="IsPrivate"
                          class="form-check-input" />

                   <label asp-for="IsPrivate"
                          class="form-check-label"></label>

               </div>

               <div class="mb-3">
                   <label asp-for="Password"
                          class="form-label"></label>
                   
                   <input asp-for="Password"
                          class="form-control"
                          autocomplete="new-password" />

                   <span asp-validation-for="Password"
                         class="text-danger"></span>

                   <div class="form-text">
                       Required for private room only.
                       Minimum 6 characters
                   </div>
               </div>

               <button type="submit"
                       class="btn btn-primary">
                    Create Room   
               </button>


                   <a asp-controller="GameRoom"
                      asp-action="Index"
                      class="btn btn-secondary ms-2">
                       Cancel
                  </a>

              </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}